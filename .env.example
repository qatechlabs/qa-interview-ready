# Copy to .env.local for local development. On Vercel, set these in Project Settings > Environment Variables.

# Required in production. Any random string of 32+ characters. Signs the access cookie for buyers.
# Generate one: openssl rand -base64 48
ACCESS_TOKEN_SECRET=

# Razorpay keys (Dashboard > Settings > API Keys). Use test keys (rzp_test_...) until you go live.
# Server-only: the key ID is handed to the browser by /api/checkout/order, so no NEXT_PUBLIC_ copy is needed
# and the secret never reaches the client.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Price in the smallest unit (paise). 99900 = ₹999. Currency defaults to INR. Overrides the default in src/lib/config.ts.
PRICE_AMOUNT=99900
PRICE_CURRENCY=INR

# How many questions at the start of each level are free.
FREE_QUESTIONS_PER_LEVEL=8

# Public site details
NEXT_PUBLIC_SITE_URL=https://interview.qatechlabs.com
NEXT_PUBLIC_SUPPORT_EMAIL=support@qatechlabs.com
NEXT_PUBLIC_BUSINESS_NAME=QA Tech Labs
